{
  "name": "baselinker-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the BaseLinker API (read-only)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "baselinker-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
