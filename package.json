{
  "name": "baselinker-mcp",
  "version": "0.2.0",
  "description": "MCP server exposing the BaseLinker API over stdio or authenticated HTTP",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "baselinker-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start:http": "node dist/index.js --transport http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jose": "^6.2.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "baselinker",
    "claude",
    "e-commerce",
    "erp",
    "oauth",
    "keycloak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiotrRaszkowski/baselinker-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/PiotrRaszkowski/baselinker-mcp/issues"
  },
  "homepage": "https://github.com/PiotrRaszkowski/baselinker-mcp#readme",
  "author": "Piotr Raszkowski"
}
