# --- BaseLinker ---
BASELINKER_API_TOKEN=your-token-here

# Expose write methods (add*/set*/delete*/update*/create*/run*).
# Unset or false keeps the server read-only.
# BASELINKER_ALLOW_WRITES=false

# --- Transport (only needed for the remote HTTP deployment) ---
# stdio (default) or http. CLI flags --transport/--host/--port/--path take precedence.
# BASELINKER_MCP_TRANSPORT=http
# BASELINKER_MCP_HOST=0.0.0.0
# BASELINKER_MCP_PORT=8000
# BASELINKER_MCP_PATH=/mcp

# --- OAuth (required when transport is http) ---
# Keycloak realm that issues access tokens for this server.
# BASELINKER_MCP_AUTH_REALM_URL=https://keycloak.example.com/realms/mcpservers
# Public URL of this server, used as the OAuth resource identifier.
# BASELINKER_MCP_AUTH_BASE_URL=https://baselinker-mcp.example.com
# Optional audience check (requires an audience mapper in Keycloak).
# BASELINKER_MCP_AUTH_AUDIENCE=baselinker-mcp
# Scopes every access token must carry. Defaults to "openid".
# BASELINKER_MCP_AUTH_REQUIRED_SCOPES=openid
# Start HTTP transport without any authentication. Never do this on a public endpoint.
# BASELINKER_MCP_AUTH_DISABLED=false
